node_modules/
.wrangler/
dist/
.env
.dev.vars
~$*.xlsx
__pycache__/

# 브랜드 배너 원본 사진은 용량이 커서(수 MB) 추적하지 않는다 —
# 웹용으로 리사이즈·압축한 파생본(brand-*.jpg 등 아래 화이트리스트)만 커밋한다
assets/banners/*
!assets/banners/florist-bouquet.jpg
!assets/banners/lifestyle.jpg
!assets/banners/workshop.jpg
!assets/banners/brand-*.jpg

# 위와 같은 이유로 블로그 글의 원본 소재도 추적하지 않는다.
# 글이 실제로 참조하는 건 리사이즈한 .jpg 파생본이고(예: summer-fresh-flower-care는
# cover.jpg / stem-trim.jpg / mood-lamp.jpg만 쓴다), 촬영 원본 PNG·MP4는 수 MB짜리다.
blog/**/*.png
blog/**/*.mp4
!blog/**/cover.png

# 아직 글로 만들지 않은 소재 사진 모음 폴더 (참조하는 글이 생기면
# 웹용으로 압축해 해당 글 폴더에 .jpg로 넣고 커밋한다)
blog/preserved/
blog/택배/
# 졸업식 소재 원본 — 손님 아이 이름이 찍힌 토퍼 사진이 섞여 있어 특히 배포되면 안 된다
blog/새 폴더/

# 초안에 넣을 사진을 슬롯별로 모아두는 곳 (docs/drafts/images/<slug>/cover.jpg, 1.jpg …).
# prepare-images.js 가 여기서 읽어 3:2·1200px 로 압축해 blog/<slug>/ 에 넣는다.
# 촬영 원본은 수 MB짜리라 추적하지 않는다 — 커밋되는 건 그 파생본뿐.
docs/drafts/images/

# 상세페이지·카드뉴스 작업용 원본 사진 (웹에 올리는 파생본만 커밋)
assets/*.png
!assets/icons/
